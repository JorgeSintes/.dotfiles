#!/bin/sh
set -eu

devices_json=$(hyprctl devices -j)

main_keyboard=$(printf '%s\n' "$devices_json" | jq -r '.keyboards[] | select(.main == true) | .name')
current_layout=$(printf '%s\n' "$devices_json" | jq -r '.keyboards[] | select(.main == true) | .active_keymap')

if [ -z "$main_keyboard" ] || [ "$main_keyboard" = "null" ]; then
  main_keyboard=$(printf '%s\n' "$devices_json" | jq -r '.keyboards[0].name // empty')
  current_layout=$(printf '%s\n' "$devices_json" | jq -r '.keyboards[0].active_keymap // empty')
fi

case "$current_layout" in
  "English (US)")
    next_index=1
    message="🇪🇸 Español"
    ;;
  "Spanish")
    next_index=2
    message="🇩🇰 Dansk"
    ;;
  *)
    next_index=0
    message="🇺🇸 English (US)"
    ;;
esac

printf '%s\n' "$devices_json" | jq -r '.keyboards[].name' | while IFS= read -r keyboard; do
  hyprctl switchxkblayout "$keyboard" "$next_index" >/dev/null 2>&1 || true
done

notify-send -u low "Keyboard layout" "$message"
